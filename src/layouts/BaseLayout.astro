---
/**
 * The only layout. Header, footer, <head>.
 *
 * Nav links, socials and the address come from src/data/site.yaml — never
 * hardcode them here.
 */
import { Font, getImage } from 'astro:assets';
import { site } from '../lib/content';
import logo from '../assets/site/logo.png';
import logoDark from '../assets/site/logo-dark.png';
import '../styles/globals.css';
import { Icon } from 'astro-icon/components';

const socialIcons: Record<string, string> = {
  Instagram: 'prime:instagram',
  GitHub: 'prime:github',
  YouTube: 'prime:youtube',
  X: 'prime:twitter',
  Facebook: 'prime:facebook',
  LinkedIn: 'prime:linkedin',
  TikTok: 'prime:tiktok',
};

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const year = new Date().getFullYear();

// Dark mode has no toggle or client JS (prefers-color-scheme only), so the
// logo swap must happen in pure HTML/CSS: a <picture> with a media-query
// <source>. Astro's <Image> component only handles format fallbacks
// (avif/webp), not art-directed swaps by media query, so the light and dark
// variants are rendered by hand through getImage() instead.
const headerLogoLight = await getImage({ src: logo, widths: [140, 280], format: 'webp' });
const headerLogoDark = await getImage({ src: logoDark, widths: [140, 280], format: 'webp' });
const footerLogoLight = await getImage({ src: logo, widths: [320, 640], format: 'webp' });
const footerLogoDark = await getImage({ src: logoDark, widths: [320, 640], format: 'webp' });
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/yetilogo.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-libre-franklin" preload />
    <Font cssVariable="--font-space-grotesk" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header
      class="border-border bg-background supports-[backdrop-filter]:bg-background/72 sticky top-0 z-10 border-b supports-[backdrop-filter]:backdrop-blur-md"
    >
      <div class="wrap max-w-wide flex flex-wrap items-center justify-between gap-4 py-2">
        <a class="inline-flex" href="/" aria-label={`${site.name} home`}>
          <picture>
            <source
              srcset={headerLogoDark.srcSet.attribute}
              sizes="70px"
              media="(prefers-color-scheme: dark)"
            />
            <img
              src={headerLogoLight.src}
              srcset={headerLogoLight.srcSet.attribute}
              sizes="70px"
              alt={site.name}
              width={headerLogoLight.attributes.width}
              height={headerLogoLight.attributes.height}
              loading="lazy"
              decoding="async"
              class="h-9 w-auto"
            />
          </picture>
        </a>
        <nav aria-label="Main">
          <ul class="m-0 flex list-none flex-wrap gap-6 p-0">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer
      class="border-border bg-background relative isolate mt-20 overflow-hidden border-t py-[clamp(3rem,7vw,6rem)]"
    >
      <div class="footer-skyline" aria-hidden="true"></div>
      <div
        class="wrap max-w-wide grid grid-cols-1 items-start gap-12 gap-x-8 min-[30rem]:grid-cols-2 min-[47rem]:grid-cols-[minmax(15rem,1.3fr)_0.8fr_1fr] min-[47rem]:gap-[clamp(2.5rem,8vw,7rem)]"
      >
        <section class="col-span-full min-[47rem]:col-auto" aria-label={site.name}>
          <a
            class="text-foreground inline-flex items-center no-underline"
            href="/"
            aria-label={`${site.name} home`}
          >
            <picture>
              <source
                srcset={footerLogoDark.srcSet.attribute}
                sizes="160px"
                media="(prefers-color-scheme: dark)"
              />
              <img
                src={footerLogoLight.src}
                srcset={footerLogoLight.srcSet.attribute}
                sizes="160px"
                alt={site.name}
                width={footerLogoLight.attributes.width}
                height={footerLogoLight.attributes.height}
                loading="lazy"
                decoding="async"
                class="h-auto w-full max-w-64"
              />
            </picture>
          </a>
          <address class="mt-4 text-base leading-[1.45] not-italic">
            {site.address.street}<br />
            {`${site.address.city}, ${site.address.state} ${site.address.zip}`}
          </address>
          <p class="text-muted-foreground mt-4 mb-0 leading-[1.45]">
            {`© ${year} ${site.name}`}<br />FRC Team 3506
          </p>
        </section>

        <section aria-labelledby="footer-links-heading">
          <h2 id="footer-links-heading" class="border-primary mb-6 border-b-[0.35rem] pb-2 text-xl">
            Links
          </h2>
          <ul class="m-0 grid list-none gap-2 p-0">
            {
              site.nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="text-foreground hover:text-primary-strong focus-visible:text-primary-strong text-lg no-underline hover:underline focus-visible:underline"
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="footer-social-heading">
          <h2
            id="footer-social-heading"
            class="border-primary mb-6 border-b-[0.35rem] pb-2 text-xl"
          >
            Follow Us
          </h2>
          <ul class="m-0 mb-6 flex list-none flex-wrap gap-4 p-0">
            {
              site.socials.map((social) => (
                <li>
                  <a
                    href={social.href}
                    aria-label={social.label}
                    title={social.label}
                    class="text-foreground hover:text-primary-strong focus-visible:text-primary-strong grid size-10 place-items-center rounded-full border-2 border-current font-extrabold no-underline"
                  >
                    <Icon name={socialIcons[social.label]} class="size-8" />
                  </a>
                </li>
              ))
            }
          </ul>
          <a
            class="bg-secondary text-secondary-foreground inline-block rounded-lg px-8 py-[0.65rem] text-lg tracking-[0.08em] no-underline hover:bg-[#f2bc1d] focus-visible:bg-[#f2bc1d]"
            href={site.paypal}
          >
            Donate
          </a>
        </section>
      </div>
    </footer>
  </body>
</html>

<style>
  /*
   * Stays hand-written: eight stacked linear-gradients with per-layer position
   * and size, plus a mask. Expressing this as utilities would mean embedding
   * the whole declaration in a class name.
   */
  .footer-skyline {
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 65%;
    opacity: 0.55;
    background:
      linear-gradient(to top, var(--skyline) 0 18%, transparent 18%) 0 100% / 100% 100% no-repeat,
      linear-gradient(to top, var(--skyline) 0 62%, transparent 62%) 8% 100% / 7% 72% no-repeat,
      linear-gradient(to top, var(--skyline) 0 78%, transparent 78%) 18% 100% / 5% 58% no-repeat,
      linear-gradient(to top, var(--skyline) 0 70%, transparent 70%) 31% 100% / 9% 68% no-repeat,
      linear-gradient(to top, var(--skyline) 0 84%, transparent 84%) 47% 100% / 5% 82% no-repeat,
      linear-gradient(to top, var(--skyline) 0 65%, transparent 65%) 58% 100% / 11% 61% no-repeat,
      linear-gradient(to top, var(--skyline) 0 80%, transparent 80%) 76% 100% / 7% 73% no-repeat,
      linear-gradient(to top, var(--skyline) 0 72%, transparent 72%) 91% 100% / 6% 65% no-repeat;
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }
</style>
