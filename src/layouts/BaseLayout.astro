---
/**
 * The only layout. Header, footer, <head>.
 *
 * Nav links, socials and the address come from src/data/site.yaml — never
 * hardcode them here.
 */
import { Font } from 'astro:assets';
import { site } from '../lib/content';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/yetilogo.png" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="generator" content={Astro.generator} />
    <Font cssVariable="--font-libre-franklin" preload />
    <Font cssVariable="--font-space-grotesk" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="container" data-width="wide">
        <a class="brand" href="/">{site.name}</a>
        <nav aria-label="Main">
          <ul>
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="footer-skyline" aria-hidden="true"></div>
      <div class="container footer-grid" data-width="wide">
        <section class="footer-identity" aria-label={site.name}>
          <a class="footer-brand" href="/" aria-label={`${site.name} home`}>
            <img src="favicon.ico" alt="" width="82" height="91" />
            <span class="footer-wordmark">
              <strong>YETI</strong>
              <span>3506</span>
            </span>
          </a>
          <address>
            {site.address.street}<br />
            {site.address.city}, {site.address.state}
            {site.address.zip}
          </address>
          <p class="fine-print">© {year} {site.name}<br />FRC Team 3506</p>
        </section>

        <section class="footer-column" aria-labelledby="footer-links-heading">
          <h2 id="footer-links-heading">Links</h2>
          <ul class="footer-links">
            {
              site.nav.map((item) => (
                <li>
                  <a href={item.href}>{item.label}</a>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="footer-column" aria-labelledby="footer-social-heading">
          <h2 id="footer-social-heading">Follow Us</h2>
          <ul class="socials">
            {
              site.socials.map((social) => (
                <li>
                  <a href={social.href} aria-label={social.label} title={social.label}>
                    {social.label.slice(0, 1)}
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="donate" href={site.paypal}>Donate</a>
        </section>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: var(--border);
  }

  .site-header .container {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }

  .brand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: inherit;
    text-decoration: none;
  }

  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .site-footer {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    margin-top: var(--space-7);
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: var(--border);
    background: #fff;
  }

  .footer-skyline {
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: 65%;
    opacity: 0.55;
    background:
      linear-gradient(to top, #edf1f3 0 18%, transparent 18%) 0 100% / 100% 100% no-repeat,
      linear-gradient(to top, #edf1f3 0 62%, transparent 62%) 8% 100% / 7% 72% no-repeat,
      linear-gradient(to top, #edf1f3 0 78%, transparent 78%) 18% 100% / 5% 58% no-repeat,
      linear-gradient(to top, #edf1f3 0 70%, transparent 70%) 31% 100% / 9% 68% no-repeat,
      linear-gradient(to top, #edf1f3 0 84%, transparent 84%) 47% 100% / 5% 82% no-repeat,
      linear-gradient(to top, #edf1f3 0 65%, transparent 65%) 58% 100% / 11% 61% no-repeat,
      linear-gradient(to top, #edf1f3 0 80%, transparent 80%) 76% 100% / 7% 73% no-repeat,
      linear-gradient(to top, #edf1f3 0 72%, transparent 72%) 91% 100% / 6% 65% no-repeat;
    mask-image: linear-gradient(to bottom, transparent, #000 30%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: minmax(15rem, 1.3fr) 0.8fr 1fr;
    gap: clamp(2.5rem, 8vw, 7rem);
    align-items: start;
  }

  .footer-brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    text-decoration: none;
  }

  .footer-brand img {
    width: 5.25rem;
    height: 5.75rem;
    object-fit: contain;
  }

  .footer-wordmark {
    display: grid;
    margin-left: -0.15rem;
    font-family: var(--font-sans);
    font-weight: 900;
    line-height: 0.75;
  }

  .footer-wordmark strong {
    color: #0b0e11;
    font-size: clamp(2.35rem, 4vw, 3.55rem);
    letter-spacing: -0.12em;
  }

  .footer-wordmark span {
    color: var(--color-accent);
    font-size: clamp(1.65rem, 3vw, 2.4rem);
    letter-spacing: -0.06em;
    text-align: right;
  }

  address {
    margin-top: var(--space-3);
    font-size: var(--text-base);
    font-style: normal;
    line-height: 1.45;
  }

  .footer-column h2 {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 0.35rem solid var(--color-accent);
    font-size: var(--text-xl);
  }

  .footer-links,
  .socials {
    padding: 0;
    list-style: none;
  }

  .footer-links {
    display: grid;
    gap: var(--space-2);
    margin: 0;
  }

  .footer-links a {
    color: var(--color-text);
    font-size: var(--text-lg);
    text-decoration: none;
  }

  .footer-links a:hover,
  .footer-links a:focus-visible {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0 0 var(--space-4);
  }

  .socials a {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border: 2px solid currentColor;
    border-radius: 50%;
    color: var(--color-text);
    font-weight: 800;
    text-decoration: none;
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--color-accent-strong);
  }

  .donate {
    display: inline-block;
    padding: 0.65rem 2rem;
    border-radius: var(--radius);
    background: #ffd044;
    color: #101820;
    font-size: var(--text-lg);
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .donate:hover,
  .donate:focus-visible {
    background: #f2bc1d;
  }

  .fine-print {
    color: var(--color-text-muted);
    margin: var(--space-3) 0 0;
    line-height: 1.45;
  }

  @media (max-width: 47rem) {
    .footer-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6) var(--space-5);
    }

    .footer-identity {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 30rem) {
    .footer-grid {
      grid-template-columns: 1fr;
    }

    .footer-identity {
      grid-column: auto;
    }
  }
</style>
