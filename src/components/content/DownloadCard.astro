---
/**
 * One downloadable file.
 *
 * File type, size and last-modified date are read off disk at build time by
 * fileMeta() — never hand-typed into frontmatter, so they cannot go stale when
 * someone replaces the PDF.
 */
import type { CollectionEntry } from 'astro:content';
import { fileMeta, formatDate } from '../../lib/content';

interface Props {
  download: CollectionEntry<'downloads'>;
}

const { download } = Astro.props;
const { title, description, file, updated, featured } = download.data;
const meta = fileMeta(file);
---

<article class="border-border rounded-md border p-6">
  <h3 class="mb-2 text-lg">
    <a href={file} download>{title}</a>
    {
      featured && (
        <span class="border-border ml-2 inline-block rounded-full border px-2 align-middle text-sm font-normal">
          Featured
        </span>
      )
    }
  </h3>
  <p>{description}</p>
  <p class="text-muted-foreground m-0 text-sm">
    {meta.extension} · {meta.size} · Updated <time datetime={updated.toISOString()}
      >{formatDate(updated)}</time
    >
  </p>
</article>
