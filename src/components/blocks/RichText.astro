---
/**
 * The `richText` block: long-form prose.
 *
 * This is the default answer to "I need a section for X". Reach for a new block
 * type only when the same shape appears on several pages.
 */
import type { BlockProps } from '../../schemas/blocks';
import { slug } from '../../lib/slug';
import { md } from '../../lib/md';
import Prose from '../ui/Prose.astro';

type Props = BlockProps<'richText'>;

const { heading, markdown, width } = Astro.props;

/** `default` needs no extra class: `wrap` is already max-w-default. */
const widthClass = { narrow: 'max-w-narrow', default: '', wide: 'max-w-wide' }[width];
---

<section class="py-12" id={slug(heading)}>
  <div class:list={['wrap', widthClass]}>
    {heading && <h2>{heading}</h2>}
    <Prose html={md(markdown)} />
  </div>
</section>
