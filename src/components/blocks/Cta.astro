---
/** The `cta` block: a closing band with one or two buttons. */
import type { BlockProps } from '../../schemas/blocks';
import { md } from '../../lib/md';
import Button from '../ui/Button.astro';
import Prose from '../ui/Prose.astro';

type Props = BlockProps<'cta'>;

const { headline, bodyMarkdown, actions, tone } = Astro.props;
---

<section class:list={['py-12 text-center', tone === 'accent' && 'bg-foreground text-background']}>
  <div class="wrap max-w-narrow">
    <h2>{headline}</h2>
    {bodyMarkdown && <Prose html={md(bodyMarkdown)} />}
    <div class="mt-6 flex flex-wrap justify-center gap-4">
      {actions.map((action) => <Button {...action} />)}
    </div>
  </div>
</section>
