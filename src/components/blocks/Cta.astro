---
/** The `cta` block: a closing band with one or two buttons. */
import type { BlockProps } from '../../schemas/blocks';
import { md } from '../../lib/md';
import Button from '../ui/Button.astro';
import Prose from '../ui/Prose.astro';

type Props = BlockProps<'cta'>;

const { headline, bodyMarkdown, actions, tone } = Astro.props;
---

<section class="cta section" data-tone={tone}>
  <div class="container" data-width="narrow">
    <h2>{headline}</h2>
    {bodyMarkdown && <Prose html={md(bodyMarkdown)} />}
    <div class="actions">
      {actions.map((action) => <Button {...action} />)}
    </div>
  </div>
</section>

<style>
  .cta {
    text-align: center;
  }

  .cta[data-tone='accent'] {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    justify-content: center;
    margin-top: var(--space-4);
  }
</style>
