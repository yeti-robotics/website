---
/** The `sponsorWall` block. All the work happens in SponsorGrid. */
import type { BlockProps } from '../../schemas/blocks';
import { slug } from '../../lib/slug';
import SponsorGrid from '../content/SponsorGrid.astro';

type Props = BlockProps<'sponsorWall'>;

const { heading, tiers, showBlurbs } = Astro.props;
---

<section class="py-12" id={slug(heading)}>
  <div class="wrap max-w-wide">
    <h2>{heading}</h2>
    <SponsorGrid tiers={tiers} showBlurbs={showBlurbs} />
  </div>
</section>
