---
/**
 * One-off: upcoming events, read from the events collection.
 *
 * Note what is NOT here: a date. Dates live in src/content/events/, so a past
 * event drops off this list at the next build instead of sitting on the page
 * for a year telling visitors to show up to something that already happened.
 */
import { upcomingEvents, formatDateTime } from '../../../lib/content';

const events = await upcomingEvents();
---

{
  events.length === 0 ? (
    <p class="text-muted-foreground">
      Nothing on the calendar right now. Add an event in src/content/events/ and it appears here.
    </p>
  ) : (
    <ul class="m-0 list-none p-0">
      {events.map((event) => (
        <li class="[&+li]:border-border [&+li]:mt-6 [&+li]:border-t [&+li]:pt-6">
          <h3 class="mb-1">{event.data.title}</h3>
          <p class="text-muted-foreground text-sm">
            <time datetime={event.data.start.toISOString()}>
              {formatDateTime(event.data.start)}
            </time>
            {' · '}
            {event.data.location}
          </p>
          <p>{event.data.description}</p>
          {event.data.registrationUrl && (
            <p>
              <a href={event.data.registrationUrl} rel="noopener noreferrer" target="_blank">
                Sign up
              </a>
            </p>
          )}
        </li>
      ))}
    </ul>
  )
}
