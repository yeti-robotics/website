---
/** The `statBand` block: a row of two to four numbers. */
import type { BlockProps } from '../../schemas/blocks';
import { slug } from '../../lib/slug';

type Props = BlockProps<'statBand'>;

const { heading, stats } = Astro.props;
---

<section class="stat-band section" id={slug(heading)}>
  <div class="container">
    {heading && <h2>{heading}</h2>}
    <dl>
      {
        stats.map((stat) => (
          <div class="stat">
            <dt>{stat.label}</dt>
            <dd>{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style>
  .stat-band {
    background: var(--color-bg-subtle);
  }

  dl {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-4);
    margin: 0;
  }

  @media (min-width: 45rem) {
    dl {
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    }
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
  }

  dd {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
  }

  dt {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
  }
</style>
