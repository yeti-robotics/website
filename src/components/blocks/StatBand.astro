---
/** The `statBand` block: a row of two to four numbers. */
import type { BlockProps } from '../../schemas/blocks';
import { slug } from '../../lib/slug';

type Props = BlockProps<'statBand'>;

const { heading, stats } = Astro.props;
---

<section class="bg-muted py-12" id={slug(heading)}>
  <div class="wrap">
    {heading && <h2>{heading}</h2>}
    <dl
      class="m-0 grid grid-cols-2 gap-6 min-[45rem]:grid-cols-[repeat(auto-fit,minmax(9rem,1fr))]"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col-reverse">
            <dt class="text-muted-foreground text-sm">{stat.label}</dt>
            <dd class="m-0 text-2xl leading-[1.1] font-bold">{stat.value}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
