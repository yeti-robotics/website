---
/** The `gallery` block: a grid of photos with optional captions and credits. */
import type { BlockProps } from '../../schemas/blocks';
import { slug } from '../../lib/slug';
import Picture from '../ui/Picture.astro';

type Props = BlockProps<'gallery'>;

const { heading, images, columns } = Astro.props;
---

<section class="py-12" id={slug(heading)}>
  <div class="wrap max-w-wide">
    {heading && <h2>{heading}</h2>}
    <ul
      class:list={[
        'm-0 grid list-none grid-cols-1 gap-6 p-0',
        columns === '2' && 'min-[45rem]:grid-cols-2',
        columns === '3' && 'min-[45rem]:grid-cols-3',
        columns === '4' && 'min-[45rem]:grid-cols-4',
      ]}
      data-columns={columns}
    >
      {
        images.map((image) => (
          <li class="min-w-0">
            <figure class="m-0">
              <Picture
                image={image}
                widths={[400, 800]}
                sizes="(min-width: 60rem) 25rem, 100vw"
                class="aspect-4/3 w-full rounded-md object-cover"
              />
              {(image.caption || image.credit) && (
                <figcaption class="text-muted-foreground mt-2 text-sm leading-normal">
                  {image.caption}
                  {image.credit && <span class="mt-2 block italic">Photo: {image.credit}</span>}
                </figcaption>
              )}
            </figure>
          </li>
        ))
      }
    </ul>
  </div>
</section>
