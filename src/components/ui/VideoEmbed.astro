---
/**
 * A YouTube video behind a click-to-load façade.
 *
 * Nothing is requested from YouTube until a visitor clicks — no iframe, no
 * thumbnail from i.ytimg.com, no cookies. The audience here is high school
 * students, so the embed uses youtube-nocookie.com deliberately.
 *
 * We never self-host video: Workers Static Assets caps a single file at 25 MiB.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div class="video" data-video-id={id} data-video-title={title}>
  <button type="button" class="facade">
    <span class="play" aria-hidden="true">▶</span>
    <span class="label">Play video: {title}</span>
    <span class="note">Loads from YouTube when you click.</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video').forEach((wrapper) => {
    const button = wrapper.querySelector('button');
    button?.addEventListener('click', () => {
      const id = wrapper.dataset.videoId;
      const title = wrapper.dataset.videoTitle ?? 'Video';
      if (!id) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      wrapper.replaceChildren(iframe);
    });
  });
</script>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 9;
    background: var(--color-bg-inverse);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .video :global(iframe) {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .facade {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    padding: var(--space-4);
    background: none;
    border: 0;
    color: var(--color-text-inverse);
    font: inherit;
    text-align: center;
    cursor: pointer;
  }

  .play {
    font-size: var(--text-2xl);
  }

  .label {
    font-weight: 600;
  }

  .note {
    font-size: var(--text-sm);
    opacity: 0.75;
  }
</style>
