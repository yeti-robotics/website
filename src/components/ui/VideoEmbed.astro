---
/**
 * A YouTube video behind a click-to-load façade.
 *
 * Nothing is requested from YouTube until a visitor clicks — no iframe, no
 * thumbnail from i.ytimg.com, no cookies. The audience here is high school
 * students, so the embed uses youtube-nocookie.com deliberately.
 *
 * We never self-host video: Workers Static Assets caps a single file at 25 MiB.
 */
interface Props {
  id: string;
  title: string;
}

const { id, title } = Astro.props;
---

<div
  class="video bg-foreground relative aspect-video overflow-hidden rounded-md"
  data-video-id={id}
  data-video-title={title}
>
  <button
    type="button"
    class="text-background flex h-full w-full cursor-pointer flex-col items-center justify-center gap-2 border-0 bg-none p-6 text-center font-[inherit]"
  >
    <span class="text-2xl" aria-hidden="true">▶</span>
    <span class="font-semibold">Play video: {title}</span>
    <span class="text-sm opacity-75">Loads from YouTube when you click.</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>('.video').forEach((wrapper) => {
    const button = wrapper.querySelector('button');
    button?.addEventListener('click', () => {
      const id = wrapper.dataset.videoId;
      const title = wrapper.dataset.videoTitle ?? 'Video';
      if (!id) return;

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
      iframe.title = title;
      iframe.allow = 'accelerometer; autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.loading = 'lazy';
      iframe.className = 'block h-full w-full border-0';
      wrapper.replaceChildren(iframe);
    });
  });
</script>
