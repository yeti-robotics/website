---
/**
 * Every image on the site goes through here.
 *
 * Wraps Astro's <Picture> so that AVIF/WebP output and explicit dimensions are
 * decided in one place. Takes an { src, alt } object straight from a schema —
 * that pairing is why an image can never ship without alt text.
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: { src: ImageMetadata; alt: string };
  /** Rendered widths to generate. Keep the list short; each one is a build-time encode. */
  widths?: number[];
  /** The `sizes` attribute. Defaults to full-width-on-mobile, capped on desktop. */
  sizes?: string;
  /** Only the first image above the fold should be eager. */
  loading?: 'lazy' | 'eager';
  class?: string;
}

const {
  image,
  widths = [480, 800, 1200],
  sizes = '(min-width: 60rem) 60rem, 100vw',
  loading = 'lazy',
  class: className,
} = Astro.props;

/** Never upscale: drop requested widths larger than the source. */
const usable = widths.filter((w) => w <= image.src.width);
const finalWidths = usable.length > 0 ? usable : [image.src.width];

/** An SVG is already every size at once: pass it through, don't rasterise it. */
const isSvg = image.src.format === 'svg';
---

{
  isSvg ? (
    <Image
      src={image.src}
      alt={image.alt}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      class={className}
    />
  ) : (
    <Picture
      src={image.src}
      alt={image.alt}
      widths={finalWidths}
      sizes={sizes}
      formats={['avif', 'webp']}
      loading={loading}
      decoding={loading === 'eager' ? 'sync' : 'async'}
      class={className}
    />
  )
}
