---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, yetiTech } from '../../lib/content';

// Edit this list to add, remove, or reorder binder sections.
const binderSections = [
  {
    id: 'overview',
    number: '01',
    title: 'Robot Overview',
    description:
      'Start here for a quick look at the robot, our goals, and the ideas behind the design.',
  },
  {
    id: 'mechanical',
    number: '02',
    title: 'Mechanical',
    description:
      'The structure, mechanisms, prototypes, and design choices that make the robot move.',
  },
  {
    id: 'electrical',
    number: '03',
    title: 'Electrical',
    description:
      'Power distribution, wiring, sensors, and the systems connecting the robot together.',
  },
  {
    id: 'software',
    number: '04',
    title: 'Software',
    description:
      'Robot code, driver controls, autonomous routines, and the tools used to test them.',
  },
  {
    id: 'yeti-tech',
    number: '05',
    title: 'YETI Tech',
    description: null,
  },
];
---

<BaseLayout
  title="Technical Binder"
  description={`Explore the engineering and design process behind ${site.name}.`}
>
  <header class="border-border bg-muted border-b">
    <div class="wrap max-w-wide py-[clamp(4rem,10vw,8rem)]">
      <p class="text-primary-strong mb-3 font-mono text-sm font-bold tracking-[0.16em] uppercase">
        Technical Binder
      </p>
      <h1
        class="max-w-4xl text-[clamp(3rem,9vw,7rem)] leading-[0.95] font-extrabold tracking-[-0.055em]"
      >
        How we build.
      </h1>
      <p class="text-muted-foreground mt-7 max-w-2xl text-lg">
        A growing record of our robot, our engineering process, and what we learn along the way.
      </p>
      <a
        href="#binder"
        class="bg-primary text-primary-foreground hover:bg-primary-strong focus-visible:bg-primary-strong mt-8 inline-flex rounded-lg px-6 py-3 font-bold no-underline"
      >
        Explore
      </a>
    </div>
  </header>

  <div id="binder" class="wrap max-w-wide scroll-mt-20 py-[clamp(3rem,8vw,7rem)]">
    <div class="grid gap-12 lg:grid-cols-[16rem_minmax(0,1fr)]">
      <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Binder sections">
        <p class="text-muted-foreground mb-3 font-mono text-sm tracking-[0.12em] uppercase">
          In this binder
        </p>
        <nav>
          <ol class="border-border m-0 grid list-none border-l p-0">
            {
              binderSections.map((section) => (
                <li>
                  <a
                    href={`#${section.id}`}
                    class="text-foreground hover:border-primary hover:text-primary-strong focus-visible:border-primary focus-visible:text-primary-strong -ml-px grid grid-cols-[2rem_1fr] border-l-2 border-transparent px-4 py-2 no-underline"
                  >
                    <span class="text-muted-foreground font-mono text-sm">{section.number}</span>
                    <span>{section.title}</span>
                  </a>
                </li>
              ))
            }
          </ol>
        </nav>
      </aside>

      <div class="grid gap-5">
        {
          binderSections.map((section) => (
            <section
              id={section.id}
              class="border-border bg-card scroll-mt-24 rounded-xl border p-[clamp(1.5rem,4vw,3rem)]"
            >
              <div class="grid gap-5 sm:grid-cols-[3rem_1fr]">
                <span class="text-primary-strong font-mono text-sm font-bold">
                  {section.number}
                </span>
                <div>
                  <h2 class="mb-3">{section.title}</h2>
                  <p class="text-muted-foreground mb-5 max-w-2xl">{section.description}</p>
                  {section.id === 'yeti-tech' ? (
                    <div class="mt-8">
                      <div class="mb-7 max-w-2xl">
                        <p class="text-primary-strong mb-2 font-mono text-sm font-bold tracking-[0.12em] uppercase">
                          Digital projects
                        </p>
                        <h3 class="mb-3">{yetiTech.heading}</h3>
                        <p class="text-muted-foreground mb-0">{yetiTech.introduction}</p>
                      </div>

                      <div class="grid gap-4 md:grid-cols-3">
                        {yetiTech.projects.map((project, index) => {
                          const content = (
                            <>
                              <div
                                class:list={[
                                  'relative mb-5 aspect-[4/3] overflow-hidden rounded-lg border border-white/20',
                                  index === 0 && 'bg-primary',
                                  index === 1 && 'bg-secondary',
                                  index === 2 && 'bg-foreground',
                                ]}
                                aria-hidden="true"
                              >
                                <span class="absolute top-4 left-4 font-mono text-xs font-bold tracking-[0.15em] text-white/75 uppercase">
                                  YETI / 0{index + 1}
                                </span>
                                <span class="absolute right-5 bottom-2 text-[clamp(3rem,7vw,5.5rem)] leading-none font-extrabold tracking-[-0.08em] text-white/20">
                                  {project.name.slice(0, 1)}
                                </span>
                                <div class="absolute right-4 bottom-4 left-4 h-9 rounded-md border border-white/30 bg-white/15 backdrop-blur-sm" />
                              </div>
                              <p class="text-muted-foreground mb-1 font-mono text-xs tracking-[0.1em] uppercase">
                                {project.category}
                              </p>
                              <h4 class="mb-2 text-xl">{project.name}</h4>
                              <p class="text-muted-foreground mb-5 text-sm">{project.summary}</p>
                              <span class="text-primary-strong mt-auto inline-flex items-center gap-2 font-mono text-xs font-bold tracking-[0.08em] uppercase">
                                {project.status}
                                <span aria-hidden="true">→</span>
                              </span>
                            </>
                          );

                          return project.href ? (
                            <a
                              href={project.href}
                              class="border-border bg-background hover:border-primary focus-visible:border-primary flex rounded-xl border p-4 text-inherit no-underline transition-[border-color,transform] hover:-translate-y-1"
                            >
                              <article class="flex min-w-0 flex-1 flex-col">{content}</article>
                            </a>
                          ) : (
                            <article class="border-border bg-background flex min-w-0 flex-col rounded-xl border p-4">
                              {content}
                            </article>
                          );
                        })}
                      </div>
                    </div>
                  ) : (
                    <p class="text-muted-foreground mb-0 font-mono text-sm">Content coming soon</p>
                  )}
                </div>
              </div>
            </section>
          ))
        }
      </div>
    </div>
  </div>
</BaseLayout>
