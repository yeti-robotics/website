---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="wrap max-w-narrow py-12">
    <h1>Page not found</h1>
    <p>
      That page does not exist. If you followed a printed link or a QR code that used to work, email
      us and we will fix the redirect.
    </p>
    <Button label="Go to the homepage" href="/" />
  </div>
</BaseLayout>
