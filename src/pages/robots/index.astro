---
/** Every robot, newest first. Built entirely from the robots collection. */
import BaseLayout from '../../layouts/BaseLayout.astro';
import RobotCard from '../../components/content/RobotCard.astro';
import { robotsByYear } from '../../lib/content';

const robots = await robotsByYear();
---

<BaseLayout
  title="Robots"
  description="Every robot YETI Robotics has built, with the awards each one won."
>
  <div class="wrap max-w-wide py-12">
    <h1>Robots</h1>
    <p class="text-muted-foreground">
      {robots.length} robots, newest first. Each one is a file in <code>src/content/robots/</code>.
    </p>
    <div class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(18rem,1fr))] gap-6">
      {robots.map((robot) => <RobotCard robot={robot} />)}
    </div>
  </div>
</BaseLayout>
