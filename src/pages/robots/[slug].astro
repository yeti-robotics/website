---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/ui/Picture.astro';
import { robotsByYear } from '../../lib/content';

interface Props {
  robot: CollectionEntry<'robots'>;
}

export async function getStaticPaths() {
  const robots = await robotsByYear();

  return robots.map((r) => ({
    params: { slug: r.id },
    props: { robot: r },
  }));
}

const { robot } = Astro.props;
const { name, year, game, summary, hero, awards, record, gallery } = robot.data;
---

<BaseLayout title={`${year} ${name}`} description={summary}>
  <article class="wrap max-w-wide py-12">
    <p>{year} * {game}</p>
    <h1>{name}</h1>
    <p>{summary}</p>
    {
      awards.length > 0 && (
        <section class="awards">
          <h2>Awards</h2>
          <ul>
            {awards.map((award) => (
              <li>
                <strong>{award.name}</strong>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      record && (
        <section class="record">
          <h2>Record</h2>
          <p>
            {record.wins} wins - {record.losses} losses - {record.ties} ties
          </p>
          {record.stateRank !== undefined && <p>State Rank: {record.stateRank}</p>}
          {record.districtPoints !== undefined && <p>District Points: {record.districtPoints}</p>}
        </section>
      )
    }
    {
      gallery && gallery.length > 0 && (
        <section>
          <h2>Gallery</h2>

          {gallery.map((photo) => (
            <figure>
              <Picture
                image={photo}
                loading="lazy"
                widths={[400, 800, 1200]}
                sizes="(min-width: 60rem) 30rem, 100vw"
              />

              {photo.caption && <figcaption>{photo.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }
    <Picture
      image={hero}
      loading="eager"
      widths={[600, 1000, 1600]}
      sizes="(min-width: 60rem) 60rem 100vw"
    />
  </article>
</BaseLayout>
