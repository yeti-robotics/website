---
/**
 * The kitchen sink: every block type, in every state, on one page.
 *
 * Open /dev/blocks after changing a block component. If a block breaks under an
 * empty collection or a maxed-out array, it breaks here — before it breaks on
 * the homepage.
 *
 * This page IS built into dist/. The spec put it at src/pages/_dev/, but Astro's
 * underscore prefix excludes a route from dev AND from the build, which would
 * make the kitchen sink dead code that `pnpm verify` never renders — losing the
 * only reason it exists. Building it means a broken block fails CI. It is
 * noindexed and linked from nowhere.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sections from '../../components/blocks/Sections.astro';
import { BLOCK_TYPES } from '../../schemas/blocks';

const fixtures = (await getCollection('fixtures')).sort((a, b) => a.id.localeCompare(b.id));

/** Which block types actually appear across the fixtures, so gaps are visible. */
const covered = new Set(fixtures.flatMap((f) => f.data.sections.map((s) => s.type)));
const missing = BLOCK_TYPES.filter((type) => !covered.has(type));
---

<BaseLayout
  title="Block kitchen sink"
  description="Every block type in every state. Development only."
>
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="wrap max-w-wide py-12">
    <h1>Block kitchen sink</h1>
    <p>
      Every block type rendered from <code>src/content/fixtures/</code>. Not linked from anywhere
      and excluded from search engines.
    </p>
    <p>
      <strong>{covered.size} of {BLOCK_TYPES.length}</strong> block types covered.
      {
        missing.length > 0 && (
          <span class="text-destructive font-semibold">
            Not covered: {missing.join(', ')} — add them to a fixture file.
          </span>
        )
      }
    </p>
  </div>

  {
    fixtures.map((fixture) => (
      <>
        <div class="wrap max-w-wide border-primary mt-20 border-t-[3px] py-4">
          <h2 class="mb-1">{fixture.data.title}</h2>
          <p class="text-muted-foreground m-0 text-sm">
            <code>src/content/fixtures/{fixture.id}.yaml</code> · {fixture.data.sections.length}{' '}
            sections
          </p>
        </div>
        <Sections sections={fixture.data.sections} />
      </>
    ))
  }
</BaseLayout>
