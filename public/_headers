# Cache rules, read by Cloudflare Workers Static Assets from the built output.

# Downloads get a SHORT TTL on purpose.
#
# Everything under /_astro/ has a content hash in its filename, so it can be
# cached forever. Files under /files/ are the opposite: the filename must stay
# stable because it is printed on posters and put in Instagram bios, which
# means the URL cannot bust its own cache when the document is replaced.
# One hour is the compromise — a corrected flyer reaches people the same day.
/files/*
  Cache-Control: public, max-age=3600, must-revalidate

# Hashed build output. Immutable by construction.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# HTML: always revalidate so a content edit goes live on the next request.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
